# PostHog (analytics, error capture, AI observability)
# Use the project token from your own PostHog project (Project settings -> Project API key).
# A token copied from documentation reports into someone else's project, whose alerts,
# insights and notifications you cannot read.
VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com
